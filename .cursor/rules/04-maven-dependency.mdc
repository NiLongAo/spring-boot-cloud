    <dependency>
        <groupId>cn.com.tzy</groupId>
        <artifactId>spring-boot-entity</artifactId>
    </dependency>
    
    <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-starter-openfeign</artifactId>
    </dependency>
