```

### 网关模块 (spring-boot-gateway)
```xml
<dependencies>
    <dependency>
        <groupId>cn.com.tzy</groupId>
        <artifactId>spring-boot-starter-cloud</artifactId>
    </dependency>
    
    <dependency>
        <groupId>org.springframework.cloud</groupId>
