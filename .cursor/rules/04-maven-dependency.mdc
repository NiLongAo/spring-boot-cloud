    </dependency>
    
    <!-- Starter模块 -->
    <dependency>
        <groupId>cn.com.tzy</groupId>
        <artifactId>spring-boot-starter-cloud</artifactId>
    </dependency>
    <dependency>
        <groupId>cn.com.tzy</groupId>
        <artifactId>spring-boot-starter-mybatis</artifactId>
    </dependency>
    <dependency>
        <groupId>cn.com.tzy</groupId>
        <artifactId>spring-boot-starter-redis</artifactId>
    </dependency>
    
