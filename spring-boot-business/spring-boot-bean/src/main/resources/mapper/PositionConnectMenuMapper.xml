<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.com.tzy.springbootbean.mapper.sql.PositionConnectMenuMapper">
  <resultMap id="BaseResultMap" type="cn.com.tzy.springbootentity.dome.bean.PositionConnectMenu">
    <!--@mbg.generated-->
    <!--@Table bean_position_connect_menu-->
    <result column="position_id" property="positionId" />
    <result column="menu_id" property="menuId" />
    <result column="update_user_id" property="updateUserId" />
    <result column="update_time" property="updateTime" />
    <result column="create_user_id" property="createUserId" />
    <result column="create_time" property="createTime" />
    <result column="tenant_id" property="tenantId" />
  </resultMap>
  <sql id="Base_Column_List">
    <!--@mbg.generated-->
    position_id, menu_id, update_user_id, update_time, create_user_id, create_time,
    tenant_id
  </sql>

  <select id="findPositionPrivilegeList" resultType="string">
       select
       bpcp.menu_id
       from bean_position_connect_menu bpcp,bean_menu bp
       where bpcp.position_id =#{positionId}
       and bpcp.menu_id = bp.id
  </select>

  <insert id="savePositionConnectMenu">
    insert into bean_position_connect_menu(position_id,menu_id) VALUES
    <foreach collection="menuIdList" item="menuId" separator=",">
     (#{positionId},#{menuId})
    </foreach>
  </insert>

  <delete id="deletePositionConnectMenu">
    delete from bean_position_connect_menu
    where position_id =#{positionId}
    <foreach close=")" collection="menuIdList" item="menuId" open="and menu_id IN(" separator=",">
        #{menuId}
    </foreach>
  </delete>
</mapper>