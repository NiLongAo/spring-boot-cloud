<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.com.tzy.springbootbean.mapper.sql.RoleConnectMenuMapper">
  <resultMap id="BaseResultMap" type="cn.com.tzy.springbootentity.dome.bean.RoleConnectMenu">
    <!--@mbg.generated-->
    <!--@Table bean_role_connect_menu-->
    <result column="role_id" property="roleId" />
    <result column="menu_id" property="menuId" />
    <result column="update_user_id" property="updateUserId" />
    <result column="update_time" property="updateTime" />
    <result column="create_user_id" property="createUserId" />
    <result column="create_time" property="createTime" />
    <result column="tenant_id" property="tenantId" />
  </resultMap>
  <sql id="Base_Column_List">
    <!--@mbg.generated-->
    role_id, menu_id, update_user_id, update_time, create_user_id, create_time,
    tenant_id
  </sql>

  <select id="findRolePrivilegeList" resultType="string">
       select
       brcp.menu_id
       from bean_role_connect_menu brcp,bean_menu bp
       where brcp.role_id =#{roleId}
       and brcp.menu_id = bp.auth_code
  </select>

  <insert id="saveRoleConnectMenu">
    insert into bean_role_connect_menu(role_id,menu_id) VALUES
    <foreach collection="menuIdList" item="menuId" separator=",">
     (#{roleId},#{menuId})
    </foreach>
  </insert>

  <delete id="deleteRoleConnectMenu">
    delete from bean_role_connect_menu
    where role_id =#{roleId}
    <foreach close=")" collection="menuIdList" item="menuId" open="and menu_id IN(" separator=",">
        #{menuId}
    </foreach>
  </delete>

</mapper>